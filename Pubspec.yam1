name: colornote_clone
description: A clean, offline-first ColorNote clone built with Flutter, Drift, and Riverpod.
publish_to: 'none'
version: 1.0.0+1

environment:
  sdk: '>=3.3.0 <4.0.0'

dependencies:
  flutter:
    sdk: flutter
  flutter_localizations:
    sdk: flutter

  # State Management
  flutter_riverpod: ^2.5.1

  # Local Database (Drift / SQLite)
  drift: ^2.18.0
  sqlite3_flutter_libs: ^0.5.24
  path_provider: ^2.1.3
  path: ^1.9.0

  # Utilities & Helpers
  uuid: ^4.4.0
  intl: ^0.19.0
  collection: ^1.18.0

  # Notifications & Alarms (Prepared for Feature 9)
  flutter_local_notifications: ^17.1.2
  timezone: ^0.9.3

  # UI / UX
  flutter_staggered_grid_view: ^0.7.0
  flutter_slidable: ^3.1.0

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^3.0.0
  drift_dev: ^2.18.0
  build_runner: ^2.4.9

flutter:
  uses-material-design: true
